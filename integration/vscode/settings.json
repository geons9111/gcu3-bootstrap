{
  "terminal.integrated.defaultProfile.linux": "bash",
  "files.eol": "\n",
  "files.insertFinalNewline": true,
  "files.trimTrailingWhitespace": true,
  "files.exclude": { "**/__pycache__": true, "**/.pytest_cache": true, "**/output/release-package": true },
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
  "python.terminal.activateEnvironment": true,
  "python.testing.pytestEnabled": true,
  "python.testing.pytestArgs": ["tests"],
  "ruff.enable": true,
  "[python]": {
    "editor.defaultFormatter": "charliermarsh.ruff",
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": { "source.organizeImports": "explicit" }
  },
  "yaml.schemas": {
    "./schemas/build-map.schema.json": ["build-map/build-map.yaml"],
    "./schemas/asset-inventory.schema.json": ["inventory/asset-inventory.yaml"]
  },
  "json.schemas": [
    { "fileMatch": ["**/manifest.json"], "url": "./schemas/manifest.schema.json" },
    { "fileMatch": ["**/tvp-request.json"], "url": "./schemas/tvp-request.schema.json" }
  ],
  "docker.dockerPath": "docker",
  "git.autofetch": true,
  "git.enableSmartCommit": true,
  "githubPullRequests.pullBranch": "never"
}
