{
  "name": "GCU3 DevPlatform",
  "dockerComposeFile": ["../docker/docker-compose.yml"],
  "service": "imx95-a55",
  "workspaceFolder": "/workspace",

  "features": {
    "ghcr.io/devcontainers/features/git:1": {},
    "ghcr.io/devcontainers/features/github-cli:1": {},
    "ghcr.io/devcontainers/features/python:1": { "version": "3.12" }
  },

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python", "charliermarsh.ruff",
        "ms-azuretools.vscode-docker", "eamodio.gitlens", "redhat.vscode-yaml"
      ],
      "settings": {
        "python.defaultInterpreterPath": ".venv/bin/python",
        "terminal.integrated.defaultProfile.linux": "bash"
      }
    }
  },

  "remoteEnv": {
    "HTTP_PROXY": "${localEnv:HTTP_PROXY}",
    "HTTPS_PROXY": "${localEnv:HTTPS_PROXY}",
    "NO_PROXY": "${localEnv:NO_PROXY}"
  },

  "postCreateCommand": "python3 -m venv .venv && . .venv/bin/activate && python -m pip install -U pip setuptools wheel && (pip install -e . || true)",
  "remoteUser": "vscode"
}
